# --- App ---
APP_NAME=Bamesoft
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- DB (Supabase) ---
# Pooler (recomendado en Vercel/Serverless): puerto 6543
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bamesoft

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage ---
STORAGE_BUCKET=bamesoft

# --- Logs ---
LOG_LEVEL=INFO
