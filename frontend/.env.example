PUBLIC_API_URL=http://localhost:8000/api/v1
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (verificación anti-bot del login).
# Es la SITE KEY (pública), no el secret — el secret va en Supabase.
# Panel de Cloudflare -> Turnstile -> tu widget -> Site Key.
# Si se deja vacía, el widget no aparece: úsalo solo si la protección CAPTCHA
# está APAGADA en Supabase, porque si está activa el login fallará sin token.
PUBLIC_TURNSTILE_SITE_KEY=
